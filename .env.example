# 复制为 .env 后填写。.env 不要提交到 git。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
DB_PATH=data/bank.db
DEMO_OTP=123456

# ---- IM 通道（卡 17；说明见 interfaces/im/README.md）----
# 监听地址/端口（默认 127.0.0.1:8090）
IM_HOST=127.0.0.1
IM_PORT=8090
# 飞书「自定义机器人」出消息 webhook（形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx）。
# 留空 → 只走本地回环通道（/im/loopback 进、/im/outbox 轮询出），无网也能演示。
IM_BOT_WEBHOOK=
# 机器人开了「签名校验」才需要填；留空 = 不签名
IM_BOT_SECRET=
# 开放平台事件订阅的 Verification Token（填了就校验回调来源；留空 = demo 不校验）
IM_VERIFICATION_TOKEN=
